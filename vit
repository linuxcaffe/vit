sub get_num_tasks {
  $num_tasks = 0;
  *IN = &task_open({ read => 1, err => 'null' }, 'projects');
  while(<IN>) {
    if ( $_ =~ /(\d+) task/ ) {
      $num_tasks = $1;
      last;
    }
  }
  close(IN);
}

