  my ($es,$result) = ($target eq "annotation")
                   ? &task_exec($uuid, 'denotate', '--', $str)
                   : &task_exec($uuid, 'delete');
  if ( $es != 0 ) {
    $error_msg = $result;
    &draw_error_msg();
    return;
  }
  $feedback_msg = "Deleted $target.";
  &draw_feedback_msg();
  &flash_current_task();
  $reread_needed = 1;
}

