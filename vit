sub clean_exit {
  unless( $audit ) {
    &shell_exec([$clear], 'no-wait');
  }
  if ( $audit ) {
      close(AUDIT) or die "$!";
  }

  endwin() unless isendwin();
  print "vit: audit log in $audit_file\n" if $audit;
  exit();
}

#------------------------------------------------------------------

sub error_exit {
  # do not exit VIT if we are in a try/catch block
  if ( $during_try ) {
    return
  }
  unless( $audit ) {
    &shell_exec([$clear], 'no-wait');
  }

  endwin();
  print STDERR "VIT fatal error: @_\r\n";

  if ( $audit ) {
      close(AUDIT) or die "$!";
  }

  exit(1);
}

